# Committed on purpose, and load-bearing (same as RsvpVault's web/.env.production).
#
# NEXT_PUBLIC_* variables are INLINED BY NEXT.JS AT BUILD TIME, not read at
# runtime. Putting them only in wrangler.jsonc `vars` is not enough for anything
# the browser executes: `next build` would compile the localhost fallback in
# src/lib/api.ts into every bundle, and every browser call (login included)
# would quietly fail. These values are public by definition. Nothing secret
# belongs here.
NEXT_PUBLIC_API_URL=https://api.borrowvault.3pandalabs.com
NEXT_PUBLIC_SITE_URL=https://borrowvault.3pandalabs.com
