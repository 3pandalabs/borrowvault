# BorrowVault API + worker. Copy to .env for local dev. NEVER commit real values.

# Postgres. Prod: internal connection string for the `borrowvault` database on
# the shared 3pandalabs-postgres instance, as the `borrowvault_app` role (which
# owns the database). Local: docker-compose.dev.yml (port 5434).
DATABASE_URL=postgres://borrowvault:borrowvault@localhost:5434/borrowvault
# Do NOT set MIGRATION_DATABASE_URL: there is no role split (42501 gotcha).

PORT=8080

# Access-token signing secret (refresh tokens are opaque, bcrypt-hashed rows).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# The web app's origin: CORS allow-list + password-reset links.
WEB_ORIGIN=http://localhost:3000
# Shared secret the web Worker sends as X-Internal-Secret (with X-Client-IP)
# on api-internal calls. Only then is X-Client-IP trusted for rate limiting.
# Optional; generate with: openssl rand -hex 32. Must match the web Worker.
INTERNAL_SHARED_SECRET=

# Optional extra comma-separated CORS origins (previews, Expo web, etc.)
CORS_ORIGINS=

# Cloudflare R2 (S3-compatible). One bucket for evidence, proofs and listing
# photos (key prefixes evidence/, proofs/, listings/). CORS: infra/r2-cors.json
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=borrowvault-evidence
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Temporal (API starts/updates bookingWorkflow; worker polls the queue)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=borrowvault

# Shared org mail gateway (3pandalabs/mailer). Optional. BorrowVault has NO
# verified sender yet, so sends fail soft (logged, never block an action).
MAILER_URL=https://mailer.3pandalabs.com
MAILER_TOKEN=
EMAIL_FROM_NAME=BorrowVault

# Ops-only GET /metrics bearer token (shared across org apps). Blank -> 503.
METRICS_TOKEN=

# `npm run seed` only (never read by the API). Passwords >= 10 chars.
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_SOCIETY_ADMIN_EMAIL=
SEED_SOCIETY_ADMIN_PASSWORD=
