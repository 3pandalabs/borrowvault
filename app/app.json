{
  "expo": {
    "name": "BorrowVault",
    "slug": "borrowvault-app",
    "owner": "3pandalabs",
    "scheme": "borrowvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.threepanda.borrowvault"
    },
    "android": {
      "package": "com.threepanda.borrowvault",
      "adaptiveIcon": {
        "backgroundColor": "#161A22",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "BorrowVault uses your camera to take handover and return photos of the item, so you and your neighbour both have a time-stamped record of its condition. Photos are taken only when you tap the shutter.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BorrowVault uses your location only while the handover or return camera screen is open. It checks your position about every 2 seconds there, to confirm the photos are taken inside your society. It never uses your location in the background.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BorrowVault lets you choose photos for your listings and your address proof. You pick each photo yourself. Handover and return photos always use the in-app camera.",
          "cameraPermission": "BorrowVault uses your camera to photograph your address proof (for example, a maintenance bill or rent agreement) for your society admin to verify.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#9B5CF6",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5cc8fde8-8fad-4b14-9f43-11277dfdc935"
      }
    }
  }
}
